#!/bin/sh
# Runs inside the chroot during build

set -e

# Set plymouth theme
if [ -x /usr/sbin/plymouth-set-default-theme ]; then
    plymouth-set-default-theme jalos || true
fi

# Enable NetworkManager
if [ -x /usr/bin/systemctl ]; then
    systemctl enable NetworkManager || true
fi

# Create live user with password
useradd -m -G sudo,audio,cdrom,video,plugdev,users -s /bin/bash user || true
echo "user:live" | chpasswd

# Allow passwordless sudo
echo "user ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/user

echo "jalos setup hook completed"
